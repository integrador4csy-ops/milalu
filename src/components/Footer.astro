---
// Footer.astro - Preguntas frecuentes y cierre
const faqs = [
  {
    q: "¿Cómo envío mi foto, frase o diseño?",
    a: "¡Muy fácil! Al hacer clic en 'Pedir por WhatsApp', te comunicarás directamente con nosotros. Solo adjuntas tu imagen o nos dices el texto y nosotros armamos la muestra digital."
  },
  {
    q: "¿Dónde se entregan los pedidos?",
    a: "¡Somos de Tijuana! Manejamos entregas en persona coordinadas directamente contigo por WhatsApp en puntos acordados de la ciudad (no manejamos envíos por paquetería fuera de Tijuana)."
  },
  {
    q: "¿Cuánto tiempo tarda la producción?",
    a: "Normalmente de 2 a 4 días hábiles una vez aprobado el diseño. Si tienes una fecha urgente (cumpleaños, aniversario), ¡avísanos por WhatsApp para coordinarlo!"
  },
  {
    q: "¿Tienen precios especiales por mayoreo?",
    a: "¡Sí! Ofrecemos descuentos por volumen a partir de 10 piezas para recuerdos de eventos (bodas, XV años, bautizos) y regalos corporativos para empresas."
  }
];
---

<footer class="bg-white border-t border-pink-100 pt-12 pb-12 sm:pb-14 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    
    <!-- Sección de Preguntas Frecuentes (FAQ) -->
    <div class="mb-10">
      <div class="text-center mb-6">
        <span class="text-xs font-bold text-milalu-pink bg-pink-50 px-3 py-1 rounded-full uppercase tracking-wider">
          Resolvemos tus dudas
        </span>
        <h3 class="font-bubble text-2xl font-bold text-milalu-dark mt-2">
          Preguntas Frecuentes
        </h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
        {faqs.map((faq) => (
          <div class="bg-milalu-cream/60 rounded-2xl p-4 border border-pink-100/70">
            <h4 class="font-bubble text-sm font-bold text-milalu-dark flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-pink-100 text-milalu-pink flex items-center justify-center flex-shrink-0 font-sans text-xs font-bold">
                ?
              </span>
              <span>{faq.q}</span>
            </h4>
            <p class="text-xs text-milalu-muted mt-1.5 leading-relaxed pl-7">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Cierre y Derechos -->
    <div class="pt-8 border-t border-pink-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div>
        <div class="flex items-center justify-center sm:justify-start gap-2">
          <img
            src="/images/logo.png"
            alt="Milalú"
            class="h-9 w-auto object-contain"
          />
          <span class="text-xs text-milalu-muted hidden sm:inline">• Sublimación y Regalos</span>
        </div>
        <p class="text-[11px] text-milalu-muted mt-1">
          "Detalles que hacen la vida más bonita"
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="https://instagram.com/milalu.oficial"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-milalu-muted hover:text-milalu-pink font-medium flex items-center gap-1 transition-colors"
        >
          <span>Instagram: @milalu.oficial</span>
        </a>
      </div>

      <p class="text-[11px] text-milalu-muted flex items-center gap-1 justify-center sm:justify-start">
        <span>Hecho con</span>
        <svg class="w-3.5 h-3.5 text-milalu-pink inline fill-current" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
        <span>para Milalú</span>
      </p>
    </div>

  </div>
</footer>
