---
// AboutBrand.astro - Concepto de la Marca Milalú & Redes
const brandColors = [
  { hex: '#FF6B9D', name: 'Rosa Milalú' },
  { hex: '#A78BFA', name: 'Lila Mágico' },
  { hex: '#FFD93D', name: 'Amarillo Sol' },
  { hex: '#4ECDC4', name: 'Turquesa Menta' },
  { hex: '#FF9F7D', name: 'Coral Dulce' },
  { hex: '#C7B8FF', name: 'Lavanda Pastel' },
];
---

<section id="nosotros" class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-milalu-cream via-pink-50/40 to-milalu-cream overflow-hidden">
  <div class="max-w-7xl mx-auto">
    
    <div class="bg-white rounded-3xl p-6 sm:p-10 border border-pink-100 shadow-soft relative">
      <!-- Decoración superior -->
      <div class="absolute -top-3 right-6 bg-gradient-to-r from-milalu-pink to-milalu-purple text-white text-[11px] font-bold px-3 py-1 rounded-full shadow-md flex items-center gap-1.5">
        <svg class="w-3 h-3 fill-current text-white" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
        <span>Nuestra Historia</span>
      </div>

      <div class="flex flex-col md:flex-row items-center gap-8">
        
        <!-- Tarjeta de Identidad & Ilustración completa -->
        <div class="w-full md:w-2/5 flex flex-col items-center text-center">
          <div class="relative w-48 sm:w-56 aspect-[3/4] rounded-3xl overflow-hidden border-4 border-pink-100/80 shadow-soft bg-white mb-3">
            <img
              src="/images/milalu-avatar.png"
              alt="Milalú - Emprendimiento lleno de sueños"
              class="w-full h-full object-contain p-1.5"
              loading="lazy"
            />
          </div>

          <div class="w-36 my-1">
            <img
              src="/images/logo.png"
              alt="Milalú Logo"
              class="w-full h-auto object-contain"
            />
          </div>
          <p class="text-xs text-milalu-pink font-semibold">
            Sueña • Crea • Personaliza
          </p>

          <p class="text-[11px] text-milalu-muted italic mt-2 px-2 bg-pink-50/80 py-1.5 rounded-xl border border-pink-100">
            "Gracias por apoyar un emprendimiento lleno de sueños"
          </p>

          <!-- Paleta de colores de la marca -->
          <div class="mt-4 w-full">
            <span class="text-[10px] uppercase font-bold text-milalu-muted tracking-wider block mb-1.5">
              Nuestros Colores
            </span>
            <div class="flex items-center justify-center gap-1.5">
              {brandColors.map((color) => (
                <div
                  class="w-6 h-6 rounded-full border-2 border-white shadow-xs transition-transform hover:scale-125 cursor-pointer"
                  style={`background-color: ${color.hex};`}
                  title={`${color.name} (${color.hex})`}
                ></div>
              ))}
            </div>
          </div>
        </div>

        <!-- Texto de concepto oficial de la marca -->
        <div class="w-full md:w-3/5 text-left">
          <h2 class="font-bubble text-2xl sm:text-3xl font-bold text-milalu-dark leading-tight">
            Cada detalle cuenta... <br/>
            <span class="text-milalu-pink">y las pequeñas cosas hacen grandes momentos.</span>
          </h2>

          <div class="mt-3.5 space-y-3 text-xs sm:text-sm text-milalu-dark/80 leading-relaxed font-normal">
            <p>
              Somos una marca de personalización y sublimación que convierte tus ideas en productos únicos, llenos de color, ternura y mucho amor.
            </p>
            <p class="font-medium text-milalu-purple">
              Porque en Milalú, cada producto lleva un pedacito de ti.
            </p>
          </div>

          <!-- Valores de marca con íconos vectoriales -->
          <div class="mt-5 grid grid-cols-2 sm:grid-cols-4 gap-2 text-center">
            <div class="p-2.5 rounded-2xl bg-pink-50/80 border border-pink-100 flex flex-col items-center">
              <svg class="w-5 h-5 text-milalu-pink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/>
                <path d="M9 18h6"/>
                <path d="M10 22h4"/>
              </svg>
              <p class="text-[11px] font-bold text-milalu-dark mt-1">Creatividad</p>
            </div>
            <div class="p-2.5 rounded-2xl bg-purple-50/80 border border-purple-100 flex flex-col items-center">
              <svg class="w-5 h-5 text-milalu-purple fill-current" viewBox="0 0 24 24">
                <path d="M12 2l2.4 7.4h7.6l-6.1 4.5 2.3 7.1-6.2-4.5-6.2 4.5 2.3-7.1-6.1-4.5h7.6z"/>
              </svg>
              <p class="text-[11px] font-bold text-milalu-dark mt-1">Calidad</p>
            </div>
            <div class="p-2.5 rounded-2xl bg-yellow-50/80 border border-yellow-100 flex flex-col items-center">
              <svg class="w-5 h-5 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/>
                <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/>
                <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/>
                <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/>
                <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.9 0 1.5-.7 1.5-1.5 0-.4-.2-.8-.4-1.1-.3-.3-.4-.7-.4-1.1 0-.8.7-1.5 1.5-1.5H16c3.3 0 6-2.7 6-6 0-5.5-4.5-8.8-10-8.8Z"/>
              </svg>
              <p class="text-[11px] font-bold text-milalu-dark mt-1">Personalización</p>
            </div>
            <div class="p-2.5 rounded-2xl bg-rose-50/80 border border-rose-100 flex flex-col items-center">
              <svg class="w-5 h-5 text-milalu-pink fill-current" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
              <p class="text-[11px] font-bold text-milalu-dark mt-1">Amor en detalle</p>
            </div>
          </div>

          <!-- Bloque de Instagram -->
          <div class="mt-5 p-3.5 rounded-2xl bg-gradient-to-r from-pink-500/10 via-purple-500/10 to-amber-500/10 border border-pink-200/60 flex items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
              <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-400 via-rose-500 to-purple-600 flex items-center justify-center text-white shadow-xs">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold text-milalu-dark leading-tight">Síguenos en Instagram</p>
                <p class="text-[11px] text-milalu-pink font-semibold">@milalu.oficial</p>
              </div>
            </div>
            <a
              href="https://instagram.com/milalu.oficial"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-gradient-to-r from-milalu-pink to-milalu-purple hover:opacity-95 text-white text-xs font-bold px-3.5 py-2 rounded-xl shadow-xs transition-transform active:scale-95"
            >
              Seguir
            </a>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>
