---
// Header.astro - Milalú Prominent Responsive Header (Sin barra superior, 100% Sólido Opaque)
---

<header class="sticky top-0 z-50 bg-white border-b-2 border-pink-100 shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 sm:py-3.5 flex items-center justify-between gap-4">
    
    <!-- Logo Oficial Milalú Más Visible -->
    <a href="#" class="flex items-center group py-0.5 flex-shrink-0" aria-label="Inicio Milalú">
      <img
        src="/images/logo.png"
        alt="Milalú - Sublimación y Regalos"
        class="h-10 sm:h-12 md:h-14 w-auto max-h-14 object-contain transition-transform group-hover:scale-105 drop-shadow-xs flex-shrink-0"
        loading="eager"
        height="56"
      />
    </a>

    <!-- Navegación para pantallas grandes (Desktop) - Más Visible y Destacada -->
    <nav class="hidden md:flex items-center gap-2 lg:gap-3 text-sm lg:text-base font-bold text-milalu-dark">
      <a
        href="#"
        class="px-4 py-2 rounded-xl hover:bg-pink-50 hover:text-milalu-pink transition-all"
      >
        Inicio
      </a>
      <a
        href="#catalogo"
        class="px-4 py-2 rounded-xl hover:bg-pink-50 hover:text-milalu-pink transition-all"
      >
        Catálogo
      </a>
      <a
        href="#como-pedir"
        class="px-4 py-2 rounded-xl hover:bg-pink-50 hover:text-milalu-pink transition-all"
      >
        ¿Cómo pedir?
      </a>
    </nav>

    <!-- Acciones Rápidas (Instagram + WhatsApp) -->
    <div class="flex items-center gap-2.5 sm:gap-3 flex-shrink-0">
      <!-- Botón Instagram -->
      <a
        href="https://instagram.com/milalu.oficial"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram de Milalú"
        class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-gradient-to-tr from-rose-50 to-purple-50 hover:from-rose-100 hover:to-purple-100 text-milalu-pink flex items-center justify-center transition-all border border-pink-200 shadow-xs hover:scale-105 active:scale-95 flex-shrink-0"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
      </a>

      <!-- Botón WhatsApp Destacado -->
      <a
        href="https://wa.me/5215500000000?text=%C2%A1Hola%20Milal%C3%BA!%20Quiero%20informaci%C3%B3n%20sobre%20sus%20productos%20personalizados%20en%20Tijuana%20%E2%9C%A8"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#25D366] hover:bg-[#20ba59] text-white text-xs sm:text-sm font-bold px-3 sm:px-4 py-2 sm:py-2.5 rounded-2xl flex items-center gap-1.5 sm:gap-2 shadow-md hover:shadow-lg transition-all active:scale-95 flex-shrink-0"
      >
        <img
          src="/images/whatsapp-white.png"
          alt="WhatsApp"
          class="w-4 h-4 sm:w-5 sm:h-5 object-contain flex-shrink-0"
          width="20"
          height="20"
        />
        <span>WhatsApp</span>
      </a>
    </div>

  </div>
</header>
